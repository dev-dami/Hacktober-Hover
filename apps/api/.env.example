# Google AI Studio key (https://aistudio.google.com/apikey). Without it, scans are saved
# but fields must be typed by hand, and /api/explain returns 503.
GEMINI_API_KEY=
# Gemma 4 on the Gemini API: gemma-4-31b-it (default) or gemma-4-26b-a4b-it
GEMMA_MODEL=gemma-4-31b-it
# Reviewer dashboard token. Reviewer endpoints are disabled when empty.
ADMIN_TOKEN=
PORT=8787
# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# Defaults: ../../data (repo data) and ./storage (scans, report photos, SQLite)
# DATA_DIR=
# STORAGE_DIR=
